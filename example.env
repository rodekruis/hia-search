# ---------- App ----------
PORT=8000
ENVIRONMENT=prod       # namespaces Langfuse traces (prod, dev, ...)
PROMPT_CACHE_TTL_S=300   # how long a sheet's #system-prompt is cached (seconds)

# ---------- API authentication ----------
API_KEY=               # read-only endpoints
API_KEY_WRITE=         # write endpoints (create/delete vector store)

# ---------- Azure AI Search (vector store) ----------
VECTOR_STORE_ADDRESS=
VECTOR_STORE_PASSWORD=

# ---------- PostgreSQL (LangGraph checkpoint) ----------
CHECKPOINT_DB_USER=
CHECKPOINT_DB_PASSWORD=
CHECKPOINT_DB_HOST=

# ---------- Azure OpenAI ----------
OPENAI_API_TYPE=
OPENAI_ENDPOINT=
OPENAI_API_KEY=
OPENAI_API_VERSION=

# ---------- Models ----------
MODEL_EMBEDDINGS=      # e.g. text-embedding-ada-002
MODEL_CHAT=            # e.g. gpt-4o

# ---------- Azure Application Insights ----------
APPLICATIONINSIGHTS_CONNECTION_STRING=

# ---------- Langfuse (LLM observability; tracing is disabled when keys are unset) ----------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=     # only for self-hosted or US cloud; default is EU cloud (https://cloud.langfuse.com)

# ---------- Microsoft Cognitive Services (translation) ----------
MSCOGNITIVE_KEY=
MSCOGNITIVE_LOCATION=  # e.g. westeurope

# ---------- Twilio (chat webhook signature validation) ----------
# Multiple HIA instances, each with its own Twilio account: JSON map googleSheetId -> Auth Token.
# Single-quote the value so dotenv does not mangle it.
TWILIO_AUTH_TOKENS='{"<googleSheetId>": "<twilio auth token>"}'
# Single instance alternative (ignored when TWILIO_AUTH_TOKENS is set)
TWILIO_AUTH_TOKEN=
