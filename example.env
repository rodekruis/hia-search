# ---------- App ----------
PORT=8000

# ---------- API authentication ----------
API_KEY=               # read-only endpoints
API_KEY_WRITE=         # write endpoints (create/delete vector store)

# ---------- Azure AI Search (vector store) ----------
VECTOR_STORE_ADDRESS=
VECTOR_STORE_PASSWORD=

# ---------- PostgreSQL (LangGraph checkpoint) ----------
CHECKPOINT_DB_USER=
CHECKPOINT_DB_PASSWORD=
CHECKPOINT_DB_HOST=

# ---------- Azure OpenAI ----------
OPENAI_API_TYPE=
OPENAI_ENDPOINT=
OPENAI_API_KEY=
OPENAI_API_VERSION=

# ---------- Models ----------
MODEL_EMBEDDINGS=      # e.g. text-embedding-ada-002
MODEL_CHAT=            # e.g. gpt-4o

# ---------- Azure Application Insights ----------
APPLICATIONINSIGHTS_CONNECTION_STRING=

# ---------- Microsoft Cognitive Services (translation) ----------
MSCOGNITIVE_KEY=
MSCOGNITIVE_LOCATION=  # e.g. westeurope
